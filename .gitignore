!assets/fontawesome/js/
!assets/fontawesome/js/all.min.js
assets/fontawesome/svgs/
assets/fontawesome/metadata/
assets/fontawesome/sprites/
assets/fontawesome/scss/
assets/fontawesome/less/

# Source maps (reduce repository size)
*.map

# Node.js dependencies (if any exist)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary and cache files
*.tmp
*.cache
*.log
.cache/
.tmp/

# Backup files
*.bak
*.backup
*.old

